# Required in every deployment
MODE=use

# Optional tunnel settings
PORT=8080
FLARETUNNEL_MODE=random
FLARETUNNEL_BLACKLIST=minimal

# Required only in MODE=use. The manager encodes username:password and passes
# only AUTH_PROXY_BASIC to the FlareTunnel child process.
AUTH_PROXY={"username":"REPLACE_ME","password":"REPLACE_ME"}

# Set exactly the account variable for the selected MODE. Do not commit real tokens.
CF_USE_ACCOUNTS=[{"name":"main","api_token":"REPLACE_ME","account_id":"REPLACE_ME"}]
# CF_CREATE_ACCOUNTS=[{"name":"main","api_token":"REPLACE_ME","account_id":"REPLACE_ME","target_workers":10}]
# CF_DELETE_ACCOUNTS=[{"name":"main","api_token":"REPLACE_ME","account_id":"REPLACE_ME","target_workers":10}]
